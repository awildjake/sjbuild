---
layout: none
permalink: /data/projects.json
---
[
  {% for development in site.developments %}
  {% unless forloop.last %}
  {
    "title": {{ development.title | jsonify }},
    "slug": {{ development.slug | jsonify }},
    "address": {{ development.address | jsonify }},
    "developer": {{ development.developer | jsonify }},
    "units": {{ development.units | default: 0 }},
    "phase": {{ development.phase | jsonify }},
    "last_updated": {{ development.last_updated | jsonify }},
    "geometry": {{ development.geometry | jsonify }},
    "permits": {{ development.permits | jsonify }},
    "articles": {{ development.articles | jsonify }},
    "published": {{ development.published }}
  },
  {% else %}
  {
    "title": {{ development.title | jsonify }},
    "slug": {{ development.slug | jsonify }},
    "address": {{ development.address | jsonify }},
    "developer": {{ development.developer | jsonify }},
    "units": {{ development.units | default: 0 }},
    "phase": {{ development.phase | jsonify }},
    "last_updated": {{ development.last_updated | jsonify }},
    "geometry": {{ development.geometry | jsonify }},
    "permits": {{ development.permits | jsonify }},
    "articles": {{ development.articles | jsonify }},
    "published": {{ development.published }}
  }
  {% endunless %}
  {% endfor %}
]